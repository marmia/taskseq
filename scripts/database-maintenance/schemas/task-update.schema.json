{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Taskseq 更新用JSON",
  "description": "export出力とupdate入力で共有する。省略項目は維持。不明なTask IDの扱いとDB全体の整合性は実行時に検証する。",
  "type": "object",
  "required": [
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/taskUpdate"
      }
    }
  },
  "$defs": {
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "pattern": "^[^,]*$"
        }
      ]
    },
    "taskDate": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(Z|[+-][0-9]{2}:[0-9]{2})$",
          "description": "オフセット付きISO 8601日時。実在する日時かどうかはアプリと同じ日時検証で確認する。"
        }
      ]
    },
    "nullableId": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonBlank"
        },
        {
          "type": "null"
        }
      ]
    },
    "recurrenceRule": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonBlank"
        },
        {
          "type": "null"
        }
      ],
      "description": "docs/recurrence-rule.mdの構文。日付との整合性は実行時に検証する。"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      },
      "description": "前後空白を除去しlowercaseへ正規化。同じ名前は1件として扱う。"
    },
    "taskUpdate": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlank"
        },
        "title": {
          "$ref": "#/$defs/nonBlank"
        },
        "description": {
          "type": "string"
        },
        "workNotes": {
          "type": "string"
        },
        "area": {
          "$ref": "#/$defs/name"
        },
        "start": {
          "$ref": "#/$defs/taskDate"
        },
        "due": {
          "$ref": "#/$defs/taskDate"
        },
        "recurrenceRule": {
          "$ref": "#/$defs/recurrenceRule"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "parentId": {
          "$ref": "#/$defs/nullableId"
        }
      }
    }
  }
}
