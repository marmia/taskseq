{
  "name": "taskseq",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "volta": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "node scripts/check.mjs",
    "check:verbose": "node scripts/check.mjs --verbose",
    "db:migrate:local": "bash ../scripts/local-migration.sh",
    "db:migrate:remote": "bash ../scripts/remote-migration.sh",
    "backup": "test -n \"$D1_BACKUP_DIR\" && mkdir -p \"$D1_BACKUP_DIR\" && wrangler d1 export taskseq --remote --output \"$D1_BACKUP_DIR/taskseq-$(date +%Y%m%d-%H%M%S).sql\"",
    "deploy": "node scripts/deploy.mjs",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@daypicker/react": "10.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dragdroptouch/drag-drop-touch": "2.0.3",
    "@floating-ui/react-dom": "2.1.9",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@hono/zod-validator": "^0.9.0",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-collapsible": "^1.1.17",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-switch": "^1.3.4",
    "date-fns": "^4.4.0",
    "hono": "^4.12.31",
    "i18next": "^26.4.2",
    "jose": "^6.2.4",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@cloudflare/vite-plugin": "^1.46.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  }
}
